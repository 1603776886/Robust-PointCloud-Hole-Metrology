  <widget class="QStatusBar" name="statusbar"/>
  <action name="actionOpen_PCD">
   <property name="text">
    <string>打开文件...</string>
   </property>
   <property name="toolTip">
    <string>支持打开 PCD/PLY/CSV 格式的单个点云文件。打开后直接进入三维识别视图；CSV1 高度矩阵会询问 X/Y 网格间距。</string>
   </property>
  </action>
  <action name="actionSave_PCD">
   <property name="text">
    <string>保存当前点云为PCD</string>
   </property>
   <property name="toolTip">
    <string>将当前处理后的点云保存为PCD二进制压缩格式。保存的是当前视图中的点云状态，包括经过底面去除、孔识别可视化等处理后的结果。建议在处理完成后导出保存。</string>
   </property>
  </action>
  <action name="actionUndo">
   <property name="text">
    <string>撤销(&amp;U)</string>
   </property>
   <property name="toolTip">
    <string>撤销上一步点云处理操作（底面去除、体素降采样等）。快捷键：Ctrl+U。最多保留50步历史记录，超出后自动丢弃最早的操作。注意：孔识别结果不在撤销范围内。</string>
   </property>
   <property name="shortcut">
    <string>Ctrl+U</string>
   </property>
  </action>
  <action name="actionRedo">
   <property name="text">
    <string>重做(&amp;R)</string>
   </property>
   <property name="shortcut">
    <string>Ctrl+R</string>
   </property>
  </action>
  <action name="actionSaveWithHoles">
   <property name="text">
    <string>同时保存孔数据</string>
   </property>
   <property name="checkable">
    <bool>true</bool>
   </property>
   <property name="toolTip">
    <string>保存 PCD 时在文件头注释中嵌入孔参数，重新打开后可跳过孔识别。</string>
   </property>
  </action>
  <action name="actionShowHoleDock">
   <property name="text">
    <string>孔参数列表</string>
   </property>
   <property name="toolTip">
    <string>显示/隐藏孔检测结果面板</string>
